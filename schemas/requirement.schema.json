{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "title_label",
    "source_url",
    "source_file_hash",
    "source_file_hash_label",
    "computable"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "title_label": {
      "enum": ["VERIFIED", "PARTIAL", "NOT_VERIFIED", "ASSUMPTION", "ESTIMATE"]
    },
    "source_url": {"type": "string"},
    "source_file_hash": {"type": "string"},
    "source_file_hash_label": {
      "enum": ["VERIFIED", "PARTIAL", "NOT_VERIFIED", "ASSUMPTION", "ESTIMATE"]
    },
    "computable": {"type": "boolean"},
    "node_role": {"enum": ["requirement", "parent"]},
    "provenance_note": {"type": "string"},
    "quotation": {"type": "string"},
    "span_start": {"type": "string"},
    "span_end": {"type": "string"},
    "page_no": {"type": ["integer", "null"], "minimum": 1},
    "bbox": {
      "type": ["array", "null"],
      "items": {"type": "string"},
      "minItems": 4,
      "maxItems": 4
    }
  }
}
