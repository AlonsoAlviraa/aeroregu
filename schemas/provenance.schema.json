{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin", "author", "generator_version", "seed", "statement"],
  "properties": {
    "origin": {"enum": ["synthetic", "public", "owned"]},
    "author": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "statement": {"type": "string", "minLength": 1},
    "label": {
      "enum": ["VERIFIED", "PARTIAL", "NOT_VERIFIED", "ASSUMPTION", "ESTIMATE"]
    }
  }
}
