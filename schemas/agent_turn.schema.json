{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_turn.schema.json",
  "title": "Agent turn",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "prompt_hash", "input_event_hashes", "envelope"],
  "properties": {
    "agent_id": {
      "enum": [
        "reader",
        "checker",
        "refuter",
        "scribe",
        "decision_gate",
        "moc_drafter",
        "envelope_critic",
        "change_narrator",
        "criterion_librarian",
        "connector_exporter",
        "qualification_clerk",
        "bench_attacker",
        "tenant_policy"
      ]
    },
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temperature": {"type": "string"},
    "input_event_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "output": {"type": "object"},
    "envelope": {"$ref": "envelope.schema.json"}
  }
}
