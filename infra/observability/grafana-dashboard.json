{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Evidence Layer — Production Certification Telemetry",
  "uid": "evidence-layer-q1-obs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "API & Pipeline Stage Latency p95 (s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aeroregu_pipeline_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}} p95"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "title": "SMT Solver Latency (Z3 / cvc5 p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aeroregu_smt_solver_duration_seconds_bucket[5m])) by (le, solver))",
          "legendFormat": "{{solver}} p95"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "title": "Daemon & Heavy PDF Worker Jobs",
      "type": "stat",
      "targets": [
        {
          "expr": "sum by (job_type, status) (aeroregu_daemon_jobs_total)",
          "legendFormat": "{{job_type}}:{{status}}"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 }
    },
    {
      "id": 4,
      "title": "Fail-Closed Abstention Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "aeroregu_abstain_rate",
          "legendFormat": "abstain_rate"
        }
      ],
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 }
    },
    {
      "id": 5,
      "title": "LLM Token Split (Edge On-Prem vs Cloud)",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (tier, direction) (aeroregu_llm_tokens_total)",
          "legendFormat": "{{tier}}-{{direction}}"
        }
      ],
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 }
    }
  ]
}
